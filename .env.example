# Conjecta local environment
# Copy to `.env` and fill in values. Never commit `.env`.
#
# Friends / collaboration require Supabase service role.
# See docs/local-friends-setup.md for the full walkthrough.

# --- Local convenience ---
# Uncomment only for a trusted, single-user local environment.
# CONJECTA_DISABLE_QUOTA=1

# Comma-separated mainland China mobiles that skip the free-tier daily token cap.
# CONJECTA_UNLIMITED_QUOTA_PHONES=<E164_PHONE>

# --- Supabase (required for friends, collab, cloud profiles) ---
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional (browser / anon); server prefers service role
# SUPABASE_ANON_KEY=

# --- Phone auth (required to add friends by phone across real users) ---
# Enabling JWT turns on login; without SMS you cannot send codes.
# Keep these commented to stay in local unauthenticated mode while solving.
# CONJECTA_JWT_SECRET=replace-with-at-least-32-random-bytes-here
# CONJECTA_JWT_TTL_SECONDS=604800

# Aliyun Dypns SMS (号码认证) — needed when phone auth is on
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_DYPNS_SIGN_NAME=
# ALIYUN_DYPNS_TEMPLATE_CODE=100001
# Local SMS debugging (returns verify code in API response; never use in prod)
# CONJECTA_SMS_DEBUG=1
# Comma-separated mobiles that may log in without an SMS code (ops / trusted only).
# CONJECTA_SMS_BYPASS_PHONES=<E164_PHONE>

# --- LLM (optional overrides; config.toml also works) ---
# OPENAI_API_KEY=
# CONJECTA_LLM_PROVIDER=openai
# CONJECTA_LLM_MODEL=gpt-5.6-sol
# CONJECTA_LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1

# --- Self-hosted deployments (use your own models) ---
# The hosted platform pins its approved models. A self-hosted deployment may
# widen the model surface for its own users (comma-separated provider/model):
# CONJECTA_PLATFORM_MODEL_ALLOWLIST=openai/gpt-4o,openai/gpt-5
# Model used for requests made with a user-provided (BYOK) endpoint key:
# CONJECTA_USER_API_MODEL=gpt-4o
# Bind address for `math-agent-web` (default is localhost-only):
# CONJECTA_WEB_HOST=0.0.0.0
# CONJECTA_WEB_PORT=8000

# --- Search tools (see [search] in config.toml) ---
# TAVILY_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=   # optional; arXiv search needs no key
